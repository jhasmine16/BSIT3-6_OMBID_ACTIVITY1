<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bio Data</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: rgb(241, 241, 238);
        }

        form {
            width: 500px;
            margin: 50px auto;
            padding: 25px;
            background: #a9a997;
            border: 4px solid rgb(213, 207, 92);
            border-radius: 10px;
        }

        h1 {
            text-align: center;
            color: rgb(8, 8, 7);
        }

        label {
            color: rgb(226, 226, 119);
            font-weight: bold;
            display: block;
            margin-top: 10px;
        }

        input, select {
            width: 100%;
            padding: 8px;
            margin: 5px 0 15px;
            box-sizing: border-box;
            border: 1px solid rgb(173, 192, 104);
            border-radius: 5px;
        }

        button {
            display: block;
            margin: 20px auto 0;
            padding: 10px 25px;
            background: rgb(223, 244, 106);
            color: #333;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        button:hover {
            background: #cdcbce;
        }
    </style>
</head>

<body>

<form action="/register" method="POST">
    <h1>Bio Data</h1>

    <label>Full Name</label>
    <input type="text" name="full_name" placeholder="Full Name" required>

    <label>Age</label>
    <input type="number" name="age" placeholder="Age" required>

    <label>Gender</label>
    <select name="gender" required>
        <option value="">Select Gender</option>
        <option value="Male">Male</option>
        <option value="Female">Female</option>
        <option value="Other">Other</option>
    </select>

    <label>Birthdate</label>
    <input type="date" name="birthdate" required>

    <label>Address</label>
    <input type="text" name="address" placeholder="Address" required>

    <label>Contact Number</label>
    <input type="text" name="contact_num" placeholder="Contact Number" required>

    <label>Email</label>
    <input type="email" name="email" placeholder="Email" required>

    <label>Course</label>
    <input type="text" name="course" placeholder="Course" required>

    <label>Year Level</label>
    <select name="year_level" required>
        <option value="">Select Year Level</option>
        <option value="1">1st Year</option>
        <option value="2">2nd Year</option>
        <option value="3">3rd Year</option>
        <option value="4">4th Year</option>
    </select>

    <label>Hobbies</label>
    <input type="text" name="hobbies" placeholder="Hobbies" required>

    <label>Emergency Contact Number</label>
    <input type="text" name="emergency_num" placeholder="Emergency Contact Number" required>

    <button type="submit">Register</button>
</form>

</body>
</html>